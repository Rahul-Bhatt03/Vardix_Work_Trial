{
	"name": "vardix-clinic-pipeline",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Evidence-first data pipeline that resolves facts about Swedish dental and skin clinics from public sources.",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.all.json",
		"pipeline": "tsx src/cli.ts run",
		"eval": "tsx src/cli.ts eval",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"cheerio": "^1.0.0",
		"csv-parse": "^5.5.6",
		"robots-parser": "^3.0.1",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^20.14.2",
		"tsx": "^4.16.2",
		"typescript": "^5.5.4",
		"vitest": "^2.0.5"
	},
	"engines": {
		"node": ">=20"
	}
}
